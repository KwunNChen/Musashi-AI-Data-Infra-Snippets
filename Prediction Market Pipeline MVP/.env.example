# Supabase project URL, from Settings -> API in the Supabase dashboard.
SUPABASE_URL=

# Supabase service_role key, from the same page. Bypasses Row Level Security, so keep it
# out of anything client-facing. This is what the ingestion scripts write with.
SUPABASE_SERVICE_KEY=

#FYI this is only if you're auditing the code and want to run the ingestion scripts locally. You can ignore this if you're just running the app.
#Make sure to get rid of the .example btw when you wanna fork your own version of the app. The ingestion scripts will not work without this key.

# Copy this file to .env and fill in your own values. Never commit the real .env (it's gitignored).

# Supabase project URL, from Settings -> API in the Supabase dashboard.
SUPABASE_URL=

# Supabase service_role key, from the same page. Bypasses Row Level Security, so keep it
# out of anything client-facing. This is what the ingestion scripts write with.
SUPABASE_SERVICE_KEY=
